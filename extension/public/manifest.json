{
  "manifest_version": 3,
  "name": "BlinkCare Monitor",
  "version": "1.0.7",
  "description": "ตรวจจับการกะพริบตาและแจ้งเตือนให้ดูแลสุขภาพตาระหว่างใช้งานหน้าจอ",
  "minimum_chrome_version": "116",
  "permissions": [
    "notifications",
    "offscreen",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://blink-detection-two.vercel.app/*",
    "https://blinkcare.website/*",
    "https://www.blinkcare.website/*",
    "https://api.blinkcare.website/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://blink-detection-two.vercel.app/*",
        "https://blinkcare.website/*",
        "https://www.blinkcare.website/*"
      ],
      "js": ["authBridge.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://localhost:3000 http://127.0.0.1:17321 https://api.blinkcare.website"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BlinkCare Monitor",
    "default_popup": "src/popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
